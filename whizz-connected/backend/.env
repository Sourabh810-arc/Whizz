# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB
MONGO_URI=mongodb://localhost:27017/whizz

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer - needed for forgot-password reset emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Whizz <no-reply@whizz.app>"

# Admin bootstrap (used by npm run seed:admin)
ADMIN_NAME=Whizz Admin
ADMIN_EMAIL=admin@whizz.app
ADMIN_PASSWORD=ChangeMe123!

# AI meeting summaries (optional). Without this, summaries/minutes/action
# items are still generated using a built-in offline heuristic — set this to
# get real Claude-generated summaries instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
