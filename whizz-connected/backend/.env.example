# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/whizz?retryWrites=true&w=majority

# JWT
JWT_SECRET=replace_this_with_a_long_random_secret
JWT_EXPIRES_IN=7d

# Email (Nodemailer - needed for forgot-password reset emails)
# For Gmail: enable 2FA, then generate App Password at https://myaccount.google.com/apppasswords
# Or use SendGrid, Mailgun, etc. with their SMTP credentials
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_16_char_app_password
EMAIL_FROM="Whizz <no-reply@whizz.app>"

# Admin bootstrap (used by npm run seed:admin)
ADMIN_NAME=Whizz Admin
ADMIN_EMAIL=admin@whizz.app
ADMIN_PASSWORD=ChangeMe123!

# AI meeting summaries (optional). Without this, summaries/minutes/action
# items are still generated using a built-in offline heuristic — set this to
# get real Claude-generated summaries instead.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
